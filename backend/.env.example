# MySQL Database Connection
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/medequip

# JWT Security
JWT_SECRET_KEY=medequip_super_secret_jwt_key_change_in_production_2026!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS
FRONTEND_URL=http://localhost:5173

# ML Model Directories
ML_MODELS_DIR=mlmodels

# Hospital isolation
DEFAULT_HOSPITAL_ID=HOSP-001

# NVIDIA NIM GenAI for the Nurse Equipment Assistance chatbot
# (get a key at https://build.nvidia.com -> "Generate API Key").
# Leave NVIDIA_API_KEY empty to run in retrieval-only (verbatim manual excerpt) mode.
NVIDIA_API_KEY=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_TIMEOUT_SECONDS=90
NVIDIA_MAX_TOKENS=4096

# RAG retrieval tuning
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.08
KNOWLEDGE_MAX_UPLOAD_MB=20
